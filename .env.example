# =============================================================================
# Sandra — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# =============================================================================

# ── Core Application ──────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=change-me-to-a-random-secret

# ── Authentication (NextAuth v5 / Auth.js) ───────────────────────────────────
# Required for all auth providers. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-secure-random-secret

# Base URL of the Next.js app (used for OAuth redirect URIs)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — always active
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Facebook OAuth — env-gated (only active when both are set)
# Create app at https://developers.facebook.com/
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/facebook
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=

# Controls whether the Facebook button appears in the login page
# Set to "true" only when AUTH_FACEBOOK_ID and AUTH_FACEBOOK_SECRET are configured
NEXT_PUBLIC_FACEBOOK_ENABLED=false

# Firebase Phone Auth (client-side config)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=


# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://sandra:sandra@localhost:5432/sandra?schema=public

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Voice (WebRTC realtime sessions — requires Realtime API billing on your OpenAI account)
# REALTIME_MODEL=gpt-4o-mini-realtime-preview

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your-github-token
GITHUB_ORG=edlinitiative

# ── Vector Store ──────────────────────────────────────────────────────────────
# For future production use (e.g., Pinecone, Weaviate, Qdrant)
VECTOR_STORE_PROVIDER=memory
# VECTOR_STORE_URL=
# VECTOR_STORE_API_KEY=

# ── Voice Bridge (Oracle Cloud VM) ──────────────────────────────────────────
VOICE_BRIDGE_URL=https://voice.edlight.org

# ── Channel Integrations ─────────────────────────────────────────────────────
# WhatsApp (Meta Business API)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_SECRET=           # Verify token for webhook GET challenge
# WHATSAPP_APP_SECRET=               # Meta App Secret for HMAC-SHA256 signature verification

# Instagram (Meta Graph API)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_VERIFY_TOKEN=
# Meta App Secret — used to verify webhook payload signatures (X-Hub-Signature-256)
# INSTAGRAM_APP_SECRET=

# Email (SMTP / SendGrid / etc.)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=sandra@edlight.org

# Voice (future — Twilio, etc.)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Required for admin API endpoints (/api/repos, /api/index)
# Pass as: x-api-key: <value>
ADMIN_API_KEY=change-me-to-a-random-admin-key

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
